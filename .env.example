# Copy to .env to override the defaults used by docker-compose.yml.
# Nothing here is required for local development.

PGDATABASE=ecommerce
PGUSER=ecommerce
PGPASSWORD=ecommerce
# Leave out db/seed in production to skip demo data
FLYWAY_LOCATIONS=classpath:db/migration,classpath:db/seed

# Base64-encoded, >= 256 bits. Generate one with: openssl rand -base64 32
JWT_SECRET_KEY=

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
ACTIVATE_ACCOUNT_URL=http://localhost:3000
VITE_API_BASE_URL=http://localhost:8080
